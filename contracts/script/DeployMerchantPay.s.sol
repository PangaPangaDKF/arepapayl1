pragma solidity 0.8.24;

import {Script, console2} from "forge-std/Script.sol";
import {MerchantPay} from "../src/MerchantPay.sol";

/// @notice D-034: deploys MerchantPay against the live SplitPayEscrow (same token, fee router and fee) and emits
///         MERCHANTPAY_CONFIG_JSON for scripts/mvp/deploy-merchantpay.sh to write config/l1/merchantpay.<NETWORK>.json (R7).
/// Env: NETWORK (local|fuji), ESCROW.
contract DeployMerchantPay is Script {
    function run() external {
        string memory network = vm.envString("NETWORK");
        address escrow = vm.envAddress("ESCROW");
        vm.startBroadcast();
        MerchantPay mp = new MerchantPay(escrow);
        vm.stopBroadcast();
        console2.log("MerchantPay", address(mp));

        string memory o = "mp";
        vm.serializeString(o, "_note", "GENERATED by contracts/script/DeployMerchantPay.s.sol. Do not hand-edit. TEST ONLY: testnet.");
        vm.serializeString(o, "network", network);
        vm.serializeUint(o, "chainId", block.chainid);
        vm.serializeUint(o, "deployBlock", block.number);
        vm.serializeAddress(o, "escrow", escrow);
        vm.serializeAddress(o, "token", address(mp.token()));
        vm.serializeAddress(o, "feeRouter", mp.feeRouter());
        string memory json = vm.serializeAddress(o, "merchantPay", address(mp));
        console2.log(string.concat("MERCHANTPAY_CONFIG_JSON=", json));
    }
}
