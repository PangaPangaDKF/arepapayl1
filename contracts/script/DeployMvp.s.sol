pragma solidity 0.8.24;

import {Script, console2} from "forge-std/Script.sol";
import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import {SplitPayEscrow} from "../src/SplitPayEscrow.sol";

/// @title ArepaPayTestUSD — TEST ONLY, testnet, no real money (D-022 MVP)
/// @notice 6-decimal stand-in for the bridged USDT/USDC used only by the MVP test dApp. Minting is restricted to one
///         `onboarder` address fixed at deploy (the test-KYC onboarding service), capped per call. It is NOT backed by
///         anything and must never be deployed on a network where it could be mistaken for real money (R1, N5).
contract ArepaPayTestUSD is ERC20 {
    address public immutable onboarder;
    uint256 public constant MAX_MINT = 1_000e6; // per call; a test faucet, not a money printer

    error NotOnboarder();
    error MintTooLarge();
    error ZeroAddress();

    constructor(address onboarder_) ERC20("ArepaPay Test USD (testnet)", "tUSD") {
        if (onboarder_ == address(0)) revert ZeroAddress();
        onboarder = onboarder_;
    }

    function decimals() public pure override returns (uint8) {
        return 6;
    }

    function mint(address to, uint256 amount) external {
        if (msg.sender != onboarder) revert NotOnboarder();
        if (amount > MAX_MINT) revert MintTooLarge();
        _mint(to, amount);
    }
}

/// @notice Deploys the MVP test stack: ArepaPayTestUSD + SplitPayEscrow (fee 50 bps) and writes
///         config/l1/mvp.<NETWORK>.json (generated, R7; emitted as MVP_CONFIG_JSON and saved by deploy.sh). Run through scripts/mvp/deploy.sh, which supplies the env vars
///         from the chain config and the key from the CLI key store without printing it.
/// Env: NETWORK (local|fuji), ONBOARDER, FEE_ROUTER, OWNER, CHAIN_CONFIG (path of the chain config it was built against).
contract DeployMvp is Script {
    uint16 internal constant FEE_BPS = 50;

    function run() external {
        string memory network = vm.envString("NETWORK");
        address onboarder = vm.envAddress("ONBOARDER");
        address feeRouter = vm.envAddress("FEE_ROUTER");
        address owner = vm.envAddress("OWNER");
        string memory chainConfig = vm.envString("CHAIN_CONFIG");

        vm.startBroadcast();
        ArepaPayTestUSD usd = new ArepaPayTestUSD(onboarder);
        SplitPayEscrow escrow = new SplitPayEscrow(address(usd), feeRouter, FEE_BPS, owner);
        vm.stopBroadcast();

        console2.log("ArepaPayTestUSD", address(usd));
        console2.log("SplitPayEscrow ", address(escrow));

        string memory o = "mvp";
        vm.serializeString(o, "_note", "GENERATED by contracts/script/DeployMvp.s.sol. Do not hand-edit. TEST ONLY: testnet, no real money.");
        vm.serializeString(o, "network", network);
        vm.serializeString(o, "chainConfig", chainConfig);
        vm.serializeUint(o, "chainId", block.chainid);
        vm.serializeUint(o, "deployBlock", block.number);
        vm.serializeAddress(o, "testUsd", address(usd));
        vm.serializeString(o, "testUsdName", usd.name());
        vm.serializeString(o, "testUsdSymbol", usd.symbol());
        vm.serializeUint(o, "testUsdDecimals", usd.decimals());
        vm.serializeAddress(o, "splitPayEscrow", address(escrow));
        vm.serializeUint(o, "feeBps", FEE_BPS);
        vm.serializeAddress(o, "feeRouter", feeRouter);
        vm.serializeAddress(o, "owner", owner);
        string memory json = vm.serializeAddress(o, "onboarder", onboarder);
        // foundry.toml grants no write access outside contracts/, so the JSON is emitted on one marker line and
        // scripts/mvp/deploy.sh writes it verbatim to config/l1/mvp.<NETWORK>.json after the broadcast succeeds.
        console2.log(string.concat("MVP_CONFIG_JSON=", json));
    }
}
