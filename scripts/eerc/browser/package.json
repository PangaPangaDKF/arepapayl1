{
  "name": "arepapay-eerc-browser",
  "private": true,
  "description": "D-032: builds app/vendor/eerc-lib.js (global ArepaEerc) from eerc-lib.src.mjs. Versions = those in ava-labs/EncryptedERC@8dc98cd.",
  "scripts": {
    "build": "esbuild eerc-lib.src.mjs --bundle --format=iife --global-name=ArepaEerc --platform=browser --target=es2020 --minify --legal-comments=eof --outfile=../../../app/vendor/eerc-lib.js",
    "test": "esbuild eerc-lib.src.mjs --bundle --format=esm --platform=node --outfile=.test-bundle.mjs --log-level=warning && node test.mjs"
  },
  "devDependencies": {
    "@zk-kit/baby-jubjub": "1.0.3",
    "@zk-kit/eddsa-poseidon": "1.1.0",
    "@zk-kit/poseidon-cipher": "0.3.2",
    "esbuild": "0.24.2",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.5"
  }
}
